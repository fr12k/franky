.{
    .name = .franky,
    .version = "0.29.0",
    .fingerprint = 0x827ef3f35d829231,
    .minimum_zig_version = "0.17.0-dev.1622",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "lib",
        "src",
        "test",
    },
    .dependencies = .{
        .zompress = .{
            .url = "https://github.com/fr12k/zompress/archive/refs/tags/v0.1.1.tar.gz",
            .hash = "zompress-0.0.1-hHj4JvKLAQD99DOqFg8rU0NfnwqGflzoPr0m_2A0ZmVG",
        },
        .agent_memory = .{
            // Vendored SQLite amalgamation 3.53.4 (fr12k/franky-memory).
            // v0.5.0 adds L1 memory deletion: deleteL1 (soft by default /
            // hard opt-in), restoreL1, purgeDeletedL1, a `deleted` column
            // with in-place ALTER TABLE migration of existing databases, a
            // content-guarded l1_au FTS trigger, and delete-aware
            // search/recall (deleted = 0 filter). Exposed via MemoryStore
            // vtable + MemoryContext helpers. v0.5.1 is the follow-up
            // refactor (shared execRecordStatement for delete/restore) —
            // behavior-preserving, same API.
            //
            // v0.6.0 adds the listL1 metadata projection (PR #28):
            // MemoryStore.listL1 / MemoryContext.list return only
            // {scene_name, created_time, updated_time, metadata_json} for
            // live records, with optional L1QueryFilter narrowing
            // (session_id, type, time range, limit/offset).
            //
            // v0.7.0 adds limit=0 = all matching records to listL1 (PR #29):
            // the SQL LIMIT clause is omitted when filter.limit = 0. Used by
            // franky's memory_list tool for its no-hard-limit mode (large
            // results are CCR-compressed by the agent loop).
            //
            // v0.8.0-search adds the search false-negative fix (PR #31):
            // FTS5 index now covers both content AND scene_name columns
            // (was content-only), buildFtsQuery uses OR semantics (was
            // implicit AND), and empty/whitespace queries fall back to a
            // full table scan (newest first). migrateFtsSchema rebuilds
            // legacy FTS indexes with both columns atomically.
            //
            // This is a fork pre-release tag (franky-agent/franky-memory
            // v0.8.0-search) pending an upstream fr12k/franky-memory tag
            // release — flip back to a fr12k/ tag URL once that's cut.
            .url = "https://github.com/franky-agent/franky-memory/releases/download/v0.8.0-search/franky-memory-v0.8.0-search.tar.gz",
            .hash = "agent_memory-0.5.0-yf36ftkdngDCNCl_vwo4Km_N6oFKQdYq90-C0SOyDCxv",
        },
        .franky_box = .{
            // v0.6.1 (from the original fr12k/franky-box repo) — on top of
            // the v0.5.0 build fixes, adds:
            //   - named workstreams with auto-create on dispatch
            //   - auto-generated UUID task ids and workstream linking
            //   - t_/w_ id prefixes, simplified lookup/create API
            //   - review JSON escaping / error mapping / anonymous ws join fixes
            //   - mobile-responsive admin UI (hamburger nav, card tables)
            // Client API (box_root/box_client/box_types) stays compatible:
            //   - box_client.zig unchanged
            //   - box_types.zig adds optional `workstream_id: ?[]const u8 = null`
            //   - artifact name "franky-box" preserved
            .url = "https://github.com/fr12k/franky-box/archive/refs/tags/v0.6.1.tar.gz",
            .hash = "franky_box-0.5.0-ubJnQ7NrngD6n81ugSEtLDR7bOpJWadMZwwSfUT_E4Yj",
        },
    },
}
