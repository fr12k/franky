.{
    .name = .franky,
    .version = "0.29.0",
    .fingerprint = 0x827ef3f35d829231,
    .minimum_zig_version = "0.17.0-dev.1622",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "lib",
        "src",
        "test",
    },
    .dependencies = .{
        .zompress = .{
            .url = "https://github.com/fr12k/zompress/archive/refs/tags/v0.1.1.tar.gz",
            .hash = "zompress-0.0.1-hHj4JvKLAQD99DOqFg8rU0NfnwqGflzoPr0m_2A0ZmVG",
        },
        .agent_memory = .{
            // Vendored SQLite amalgamation 3.53.4 (fr12k/franky-memory v0.5.0).
            // v0.5.0 adds L1 memory deletion on top of v0.4.2's single-L1
            // layer: deleteL1 (soft by default / hard opt-in), restoreL1,
            // purgeDeletedL1, a `deleted` column with in-place ALTER TABLE
            // migration of existing databases, a content-guarded l1_au FTS
            // trigger, and delete-aware search/recall (deleted = 0 filter).
            // Exposed via MemoryStore vtable + MemoryContext helpers. Also
            // fixes the stale integration tests (v0.4.2 test-integration
            // build was broken).
            .url = "https://github.com/franky-agent/franky-memory/archive/refs/tags/v0.5.0.tar.gz",
            // NOTE: fork URL — upstream PR fr12k/franky-memory#25 is pending merge.
            // After it merges, upstream CI tags v0.5.0 with identical content and
            // this URL flips to github.com/fr12k/franky-memory (hash unchanged).

            .hash = "agent_memory-0.5.0-yf36fsNlnQDwhE16OHwexQw2C4NxB7Md1jcgiXctl_kK",
        },
        .franky_box = .{
            // v0.6.1 (from the original fr12k/franky-box repo) — on top of
            // the v0.5.0 build fixes, adds:
            //   - named workstreams with auto-create on dispatch
            //   - auto-generated UUID task ids and workstream linking
            //   - t_/w_ id prefixes, simplified lookup/create API
            //   - review JSON escaping / error mapping / anonymous ws join fixes
            //   - mobile-responsive admin UI (hamburger nav, card tables)
            // Client API (box_root/box_client/box_types) stays compatible:
            //   - box_client.zig unchanged
            //   - box_types.zig adds optional `workstream_id: ?[]const u8 = null`
            //   - artifact name "franky-box" preserved
            .url = "https://github.com/fr12k/franky-box/archive/refs/tags/v0.6.1.tar.gz",
            .hash = "franky_box-0.5.0-ubJnQ7NrngD6n81ugSEtLDR7bOpJWadMZwwSfUT_E4Yj",
        },
    },
}